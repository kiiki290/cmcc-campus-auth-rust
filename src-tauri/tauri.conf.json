{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cmcc-campus-auth",
  "mainBinaryName": "cmcc-campus-auth",
  "version": "0.2.0",
  "identifier": "io.github.kiiki290.cmcc-campus-auth",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "校园宽带自动认证",
        "width": 440,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "校园宽带自动认证",
    "longDescription": "中国移动校园宽带 Portal 自动认证与断线重连工具。"
  }
}